{
  "name": "react-native-starter",
  "version": "2.0.0",
  "private": true,
  "description": "Expo starter app with its own API: sign-up and sign-in, a task list, light and dark themes, two languages and tests.",
  "license": "MIT",
  "author": "Muhittin Camdali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhittincamdali/ReactNativeStarter.git"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "build": "expo export --platform web --output-dir dist",
    "docs": "typedoc",
    "doctor": "expo-doctor",
    "serve": "node scripts/serve.mjs",
    "e2e:ios": "maestro test .maestro"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-server": "~58.0.6",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.9.10",
    "test-renderer": "^1.3.1",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  }
}
